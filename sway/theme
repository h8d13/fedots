# atom-dark (matches micro/settings.json colorscheme)
# include from ~/.config/sway/config *before* the bar block

set $bg      #1d1f21
set $bg-alt  #2d2f31
set $fg      #c5c8c6
set $dim     #7c7c7c
set $blue    #62b1fe
set $green   #a6e22e
set $red     #ff4444

# class                 border  bg      text  indicator child_border
client.focused          $blue   $blue   $bg   $green    $blue
client.focused_inactive $bg-alt $bg-alt $fg   $bg-alt   $bg-alt
client.unfocused        $bg     $bg     $dim  $bg       $bg
client.urgent           $red    $red    $bg   $red      $red

output * bg $bg solid_color
